{
	"name": "shredio/eodhd-client",
	"type": "library",
	"license": "MIT",
	"require": {
		"php": ">=8.4",
		"symfony/http-client": "^7.2 || ^8.0",
		"halaxa/json-machine": "^1.2",
		"shredio/type-schema": "^0.10.1",
		"psr/simple-cache": ">=1.0"
	},
	"autoload": {
		"psr-4": {
			"Shredio\\EodhdClient\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse --memory-limit=-1",
		"test": "vendor/bin/phpunit tests",
		"compile": "vendor/bin/type-schema-compile src/Payload src/Mapper Shredio\\\\EodhdClient\\\\Mapper\\\\%sMapper"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^12.2",
		"nette/utils": "^4.0",
		"shredio/type-schema-compiler": "^0.11",
		"symfony/cache": "^7.4 || ^8.0"
	}
}
